# Student Details
student_name = "Pratibha Patil"
marks_obtained = 30
percentage = 30.0
passed = marks_obtained >= 35

# Print Result Summary
print("=" * 40)
print("         ONLINE EXAM RESULT")
print("=" * 40)
print("Student Name   :", student_name)
