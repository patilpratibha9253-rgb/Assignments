# Library Management System

class Book:
    # Constructor
    def __init__(self, book_id, title, author, price):
        self.book_id = book_id
        self.title = title
        self.author = author
        self.price = price
        self.availability = True

    # Display book details
    def display_details(self):
        print("\n--- Book Details ---")
        print("Book ID:", self.book_id)
        print("Title:", self.title)
        print("Author:", self.author)
        print("Price: ₹", self.price)

        if self.availability:
            print("Availability: Available")
        else:
            print("Availability: Borrowed")

    # Borrow a book
    def borrow_book(self):
        if self.availability:
            self.availability = False
            print(self.title, "has been borrowed successfully.")
        else:
            print(self.title, "is already borrowed.")

    # Return a book
    def return_book(self):
        if not self.availability:
            self.availability = True
            print(self.title, "has been returned successfully.")
        else:
            print(self.title, "is already available.")


# Creating multiple Book objects
book1 = Book(101, "Python Programming", "John Smith", 450)
book2 = Book(102, "Data Structures", "Robert Brown", 550)
book3 = Book(103, "Computer Networks", "James Wilson", 600)

# Display details
book1.display_details()
book2.display_details()
book3.display_details()

# Borrow books
print("\n--- Borrow Operation ---")
book1.borrow_book()
book2.borrow_book()

# Display details after borrowing
book1.display_details()
book2.display_details()

# Try to borrow an already borrowed book
book1.borrow_book()

# Return a book
print("\n--- Return Operation ---")
book1.return_book()

# Display details after returning
book1.display_details()
